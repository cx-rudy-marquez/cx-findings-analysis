# Copy to .env and fill in. Nothing here is read until you run in live mode:
# demo mode (USE_FIXTURES=true) serves the whole UI from fixtures/ and needs no
# credentials and no tenant at all.
#
# Variable names deliberately match the sibling cx-analytics-and-risk-orchestration
# project, so one .env can serve both against the same tenant.

# --- Tenant ------------------------------------------------------------------
# Your Checkmarx One URL, region-specific. Copy it from the browser rather than
# guessing: eu/deu/us/anz all exist and they are not interchangeable.
CX_BASE_URL=

# The IAM host, also region-specific and *not* the same host as above. Copy it
# from the "Create API Key" page in the Checkmarx One UI.
CX_AUTH_URL=

# The tenant name, the path segment in your Checkmarx One URL.
CX_TENANT=

CX_CLIENT_ID=ast-app

# A Checkmarx One API key is an OAuth *refresh token*, not a client secret - the
# token exchange uses grant_type=refresh_token. CX_API_KEY is accepted as an
# alias for this variable, so an .env written for either project works unchanged.
#
# Treat it as a credential: it is long-lived and it is the whole of your access.
CX_CLIENT_SECRET=

# --- Mode --------------------------------------------------------------------
# true: serve everything from fixtures/, touch no tenant, and badge every number
# "Sample Data". The four variables above are then unnecessary.
USE_FIXTURES=false

# --- Runtime -----------------------------------------------------------------
CX_DB_PATH=data/findings_analysis.db
APP_HOST=127.0.0.1
APP_PORT=8060
LOG_LEVEL=INFO

# How often a running scan is polled, in seconds.
POLL_INTERVAL_SECONDS=8

# The assumption behind "analyst hours saved". Editable per run in the UI,
# because it is an assumption and not a fact about the platform.
MINUTES_PER_FINDING=10

# How old a cached portfolio snapshot may be before the UI labels it stale. It
# is still shown - refusing to render cached numbers helps nobody.
SNAPSHOT_STALE_HOURS=24

# --- Portfolio scoring and risk ----------------------------------------------
# All defaults, shown so they are discoverable. Every one is also editable in
# the UI. Uncomment to pin a value here instead.
#
# Opportunity score = High*3 + Medium*2 + Low*1. Critical is absent rather than
# weighted 0: Findings Analysis never evaluates Critical results, so a zero
# would read as a tuning choice someone could raise.
# OPPORTUNITY_WEIGHT_HIGH=3
# OPPORTUNITY_WEIGHT_MEDIUM=2
# OPPORTUNITY_WEIGHT_LOW=1

# Migration-risk cutoffs. Low needs *both* counts small; High needs *either* one
# large.
# RISK_LOW_MAX_SCANS=2
# RISK_LOW_MAX_BRANCHES=1
# RISK_HIGH_MIN_SCANS=10
# RISK_HIGH_MIN_BRANCHES=4

# How many top-scoring projects are highlighted as candidates in the list.
# OPPORTUNITY_FLAG_TOP_N=5

# How old a project's baseline scan may be before the portfolio recommends
# re-basing it. A stale baseline is not just old data - the comparison is
# anchored to it, so measuring against one from before six months of merges
# reports a difference that is partly Findings Analysis and partly the merges.
# REBASE_STALE_DAYS=90
